// GitHub'dan soru çekme fonksiyonu
async function loadQuestionsFromGitHub() {
    // GitHub raw JSON URL'nizi buraya ekleyin
    const GITHUB_URL = "https://raw.githubusercontent.com/KULLANICI/REPO/main/anayasa_sorulari.json";
    
    const modal = document.getElementById('githubModal');
    const progressBar = document.getElementById('githubProgress');
    const statusText = document.getElementById('githubStatus');
    const successCount = document.getElementById('successCount');
    
    // Modal'ı göster
    modal.style.display = 'flex';
    progressBar.style.width = '0%';
    statusText.textContent = 'GitHub bağlantısı kuruluyor...';
    
    try {
        // 1. GitHub'dan JSON'u çek
        progressBar.style.width = '30%';
        statusText.textContent = 'Soru verileri indiriliyor...';
        
        const response = await fetch(`${GITHUB_URL}?t=${Date.now()}`);
        
        if (!response.ok) {
            throw new Error(`GitHub'dan veri alınamadı: ${response.status}`);
        }
        
        const data = await response.json();
        
        progressBar.style.width = '60%';
        statusText.textContent = 'Sorular kontrol ediliyor...';
        
        // 2. Soruları kontrol et
        if (!data.questions || !Array.isArray(data.questions)) {
            throw new Error('Geçersiz soru formatı');
        }
        
        // 3. Mevcut sorularla karşılaştır
        progressBar.style.width = '80%';
        statusText.textContent = 'Yeni sorular ekleniyor...';
        
        // Bu kısmı mevcut soru yapınıza göre düzenleyin
        const newQuestionsCount = await updateLocalQuestions(data.questions);
        
        // 4. Başarılı sonuç
        progressBar.style.width = '100%';
        statusText.textContent = 'Başarılı!';
        successCount.textContent = `${newQuestionsCount} yeni soru eklendi`;
        
        // 2 saniye sonra modal'ı kapat
        setTimeout(() => {
            modal.style.display = 'none';
            
            // Kullanıcıya bildirim göster
            showNotification(`${newQuestionsCount} yeni soru başarıyla eklendi!`);
            
            // Sayfayı yenile (isteğe bağlı)
            if (newQuestionsCount > 0) {
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            }
        }, 2000);
        
    } catch (error) {
        // Hata durumu
        progressBar.style.width = '100%';
        progressBar.style.background = '#ff4757';
        statusText.innerHTML = `<span style="color:#ff4757">Hata: ${error.message}</span>`;
        console.error('GitHub yükleme hatası:', error);
    }
}

// Mevcut soruları güncelle (Bu fonksiyonu mevcut yapınıza göre düzenleyin)
async function updateLocalQuestions(newQuestions) {
    // LOCAL STORAGE örneği - mevcut sisteminize göre düzenleyin
    let currentQuestions = JSON.parse(localStorage.getItem('anayasa_sorulari') || '[]');
    
    // Yeni soruları ID'lere göre kontrol et
    const existingIds = new Set(currentQuestions.map(q => q.id));
    let addedCount = 0;
    
    newQuestions.forEach(question => {
        if (!existingIds.has(question.id)) {
            currentQuestions.push(question);
            addedCount++;
        }
    });
    
    // Güncellenmiş soruları kaydet
    localStorage.setItem('anayasa_sorulari', JSON.stringify(currentQuestions));
    
    return addedCount;
}

// Bildirim göster
function showNotification(message) {
    // Toast bildirimi oluştur
    const toast = document.createElement('div');
    toast.className = 'github-toast';
    toast.innerHTML = `
        <div class="toast-content">
            <span class="toast-icon">✅</span>
            <span class="toast-message">${message}</span>
        </div>
    `;
    
    // Toast stilleri
    toast.style.cssText = `
        position: fixed;
        top: 20px;
        right: 20px;
        background: white;
        padding: 15px 20px;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        z-index: 10000;
        animation: slideIn 0.3s ease, fadeOut 0.3s ease 2.7s;
        border-left: 4px solid #4CAF50;
    `;
    
    document.body.appendChild(toast);
    
    // 3 saniye sonra kaldır
    setTimeout(() => {
        toast.remove();
    }, 3000);
}

// Modal HTML'ini ekle
function addGitHubModal() {
    const modalHTML = `
        <div id="githubModal" class="github-modal">
            <div class="github-modal-content">
                <h3>🔄 Sorular GitHub'dan Yükleniyor</h3>
                <div class="github-progress">
                    <div id="githubProgress" class="github-progress-bar"></div>
                </div>
                <div id="githubStatus" class="github-status">Hazırlanıyor...</div>
                <div id="successCount" class="github-status" style="color:#4CAF50; font-weight:bold;"></div>
                <div class="github-buttons">
                    <button id="githubCancelBtn" class="github-btn github-btn-secondary">İptal</button>
                    <button id="githubCloseBtn" class="github-btn github-btn-primary" style="display:none;">Kapat</button>
                </div>
            </div>
        </div>
    `;
    
    document.body.insertAdjacentHTML('beforeend', modalHTML);
    
    // İptal butonu
    document.getElementById('githubCancelBtn').addEventListener('click', () => {
        document.getElementById('githubModal').style.display = 'none';
    });
    
    // Kapat butonu
    document.getElementById('githubCloseBtn').addEventListener('click', () => {
        document.getElementById('githubModal').style.display = 'none';
    });
}

// Sayfa yüklendiğinde modal'ı ekle ve butonu aktif et
document.addEventListener('DOMContentLoaded', function() {
    // Modal'ı ekle
    addGitHubModal();
    
    // Butonu bul ve event listener ekle
    const githubBtn = document.getElementById('githubBtn');
    if (githubBtn) {
        githubBtn.addEventListener('click', loadQuestionsFromGitHub);
    }
    
    // CSS animasyonları
    const style = document.createElement('style');
    style.textContent = `
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes fadeOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }
        .github-toast .toast-content {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .github-toast .toast-icon {
            font-size: 20px;
        }
        .github-toast .toast-message {
            color: #333;
            font-weight: 500;
        }
    `;
    document.head.appendChild(style);
});
